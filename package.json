{
  "name": "playoff-pal",
  "version": "1.0.0",
  "description": "Playoff Pal is a web application that allows users to create and manage their own tournaments. Easily create a tournament by selecting a tournament theme and uploading a list of participants. Playoff Pal will organize teams into a selection bracket to share with friends to pick the winners.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --env-file .env.local src/index.js",
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:rollback": "node scripts/migrate.js --rollback",
    "seed:static": "node scripts/seed.js --static",
    "seed:sample": "node scripts/seed.js --sample",
    "seed:clear": "node scripts/seed.js --clear",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "bad-words": "^3.0.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-handlebars": "^7.1.3",
    "express-mysql-session": "^3.0.0",
    "express-session": "^1.18.1",
    "hashids": "^2.3.0",
    "mysql2": "^3.12.0",
    "twilio": "^5.4.5"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "nodemon": "^3.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivachu/playoff-pal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vivachu/playoff-pal/issues"
  },
  "homepage": "https://github.com/vivachu/playoff-pal#readme"
}
